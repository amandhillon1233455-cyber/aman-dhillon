# MongoDB Atlas or local MongoDB connection URI
# If empty, the app seamlessly uses the local embedded document storage engine
MONGODB_URI=""

# JWT secret key for signing session tokens
JWT_SECRET="printai-secret-jwt-key-2026-secure"

# Gemini API Key for AI troubleshooting, summaries, and assistant
# AI Studio automatically injects this at runtime from secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server Port (default 3000)
PORT="3000"

# Application URL
APP_URL="MY_APP_URL"
CLIENT_URL=""

# Optional API URL for split frontend deployments
VITE_API_URL=""
